{
  "name": "mastergo-claude-export",
  "version": "1.0.0",
  "description": "导出 MasterGo 设计稿为 Claude Code 可读的结构化文件（design.json + 素材 + SVG/PNG 预览 + 说明文档）",
  "private": true,
  "scripts": {
    "dev": "npm run dev:ui & npm run dev:main",
    "dev:ui": "cross-env TARGET=ui vite",
    "dev:main": "cross-env TARGET=main vite",
    "build": "npm run build:ui && npm run build:main && rm -rf ./dist/assets",
    "build:ui": "cross-env TARGET=ui vite build",
    "build:main": "cross-env TARGET=main vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@mastergo/plugin-typings": "^2.19.4",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.2.4",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^2.2.10"
  }
}
